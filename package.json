{
  "name": "rival-roster",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "generate": "node tools/catalog.mjs && node tools/rules.mjs",
    "test": "node --test tests/core.test.mjs",
    "test:emulator": "firebase emulators:exec --project demo-rival-roster --only auth,database 'node --test tests/firebase.test.mjs'",
    "preview": "firebase emulators:start --project demo-rival-roster --only auth,database,hosting",
    "dev": "node tools/preview.mjs",
    "seed:emulator": "node tools/seed-emulator.mjs"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^4.0.1",
    "firebase": "^11.10.0",
    "firebase-tools": "^14.11.0"
  }
}
